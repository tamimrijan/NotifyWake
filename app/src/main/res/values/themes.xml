<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="window_bg">#FFF8F8FC</color>
    <color name="ic_launcher_background">#FF4F5BD5</color>

    <style name="Theme.NotifyWake" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Fully transparent so the lock screen (with the new notification) stays visible behind it. -->
    <style name="Theme.NotifyWake.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
